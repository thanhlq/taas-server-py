# ═══════════════════════════════════════════════════════════════════════════════
# taas-server-py — TEST environment configuration (.env.test)
#
# Setup:    cp .env.test.example .env.test   (then replace every <placeholder>)
# Used by:  ENV_FILE=.env.test (standalone, not layered on .env) and the test conftest.py files
#           (load_dotenv(.env.test, override=True)); keys not set here fall back to code defaults.
# Loaded by: foundation.config.get_settings() loads ENV_FILE or .env with python-dotenv; process env wins.
# Loaded by: .env.local is NOT loaded/layered automatically; use ENV_FILE=.env.local only deliberately.
# Rules:    never commit .env; secrets only in .env / a secret manager.
# Check:    python3 ../taas-tools/env-check/check_env.py taas-server-py
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# 1. APP RUNTIME — process identity, host/port, debug and browser origins — Core settings needed to start the FastAPI/Litestar EWS API and workers.
# ───────────────────────────────────────────────────────────────────────────────

# ENV_FILE: Dotenv file selected by bootstrap; .env is the default and .env.local is not layered automatically. Default: .env. Values: path. Optional.
# ENV_FILE=.env

# ENVIRONMENT: Runtime environment name used by settings and tests. Default: local. Values: local | test | development | staging | production. Optional.
ENVIRONMENT=test

# CONFIG_PREFIX: Prefix used by foundation AppSettings for TAAS_* keys. Default: TAAS. Values: string. Optional.
# CONFIG_PREFIX=TAAS

# TAAS_HOME_PATH: Application home path resolved by settings; normally inferred. Default: current working directory. Values: absolute path. Optional.
# TAAS_HOME_PATH=

# TAAS_SERVICE_NAME: Service name used in logs and OpenTelemetry resource attributes. Default: ews / script export. Values: string. Optional.
# TAAS_SERVICE_NAME=ews_api

# TAAS_DEBUG: Enable application debug mode. Default: False. Values: bool. Optional.
TAAS_DEBUG=true

# SECRET_KEY: Application signing secret; generate a unique random value for every environment. Default: random 32-byte hex when unset. Values: secret string. Required.
SECRET_KEY=change-me

# TENANT_PREFIX: Tenant slug prefix used by SaaS helpers. Default: taas. Values: string. Optional.
# TENANT_PREFIX=taas

# APP_URL: Public/frontend base URL used for links and redirects. Default: http://localhost. Values: URL. Optional.
APP_URL=http://localhost:8191

# TAAS_HOST: ASGI bind host. Default: 0.0.0.0. Values: host/IP. Optional.
TAAS_HOST=0.0.0.0

# TAAS_PORT: ASGI bind port; FastAPI EWS local script uses 8191. Default: 8000. Values: port. Optional.
TAAS_PORT=8191

# TAAS_KEEPALIVE: ASGI keep-alive timeout in seconds. Default: 65. Values: integer seconds. Optional.
# TAAS_KEEPALIVE=65

# TAAS_RELOAD: Enable code reload for local host runs. Default: False. Values: bool. Optional.
TAAS_RELOAD=true

# TAAS_RELOAD_DIRS: Directories watched by the reloader. Default: db module base dir. Values: JSON list or comma list. Optional.
# TAAS_RELOAD_DIRS=

# TAAS_WORKERS: Number of ASGI worker processes. Default: 1. Values: integer. Optional.
TAAS_WORKERS=1

# WEB_CONCURRENCY: Alternative process count honored by app entrypoints when set. Default: unset. Values: integer. Optional.
# WEB_CONCURRENCY=

# OPENAPI_ENABLED: Enable OpenAPI schema/docs routes. Default: True. Values: bool. Optional.
# OPENAPI_ENABLED=true

# COOKIE_SECURE: Mark cookies secure; set true behind HTTPS. Default: False. Values: bool. Optional.
# COOKIE_SECURE=false

# STATIC_DIR: Static asset directory. Default: db/server/static/web. Values: path. Optional.
# STATIC_DIR=

# STATIC_URL: URL prefix for static assets. Default: /static/web/. Values: path. Optional.
# STATIC_URL=/static/web/

# VITE_DEV_MODE: Enable local frontend/dev-mode integration paths. Default: False. Values: bool. Optional.
VITE_DEV_MODE=true

# VITE_PORT: Local Vite web port for links/CORS reference. Default: none. Values: port. Optional.
VITE_PORT=7101

# ALLOWED_CORS_ORIGINS: Allowed browser origins; include scheme such as http://localhost:7101. Default: ['*']. Values: JSON list or comma list of origins. Required for browser clients.
ALLOWED_CORS_ORIGINS=["http://localhost:7101","http://localhost:8191"]

# TAAS_CHECK_DB_CONSISTENCY: Enable database model consistency check. Default: True. Values: bool. Optional.
# TAAS_CHECK_DB_CONSISTENCY=true

# PYTHONPATH: Application root fallback used by storage FSPaths. Default: inferred. Values: path. Optional.
# PYTHONPATH=

# ENV_SECRETS: Additional environment variable read by code (libs/foundation/src/foundation/app/app_settings.py). Default: runtime-secrets. Values: see code. Optional.
# ENV_SECRETS=runtime-secrets

# RESILIANT_MAINTENANCE_CRON: Additional environment variable read by code (libs/resiliant/src/resiliant/maintenances/resiliant_maintenance.py). Default: none. Values: see code. Optional.
# RESILIANT_MAINTENANCE_CRON=

# RESILIANT_MAINTENANCE_ENABLED: Additional environment variable read by code (libs/resiliant/src/resiliant/maintenances/resiliant_maintenance.py). Default: True. Values: see code. Optional.
# RESILIANT_MAINTENANCE_ENABLED=true

# RESILIANT_TABLE_PREFIX: Additional environment variable read by code (libs/db/src/db/models/config.py). Default: resiliant_. Values: see code. Optional.
# RESILIANT_TABLE_PREFIX=resiliant_

# TAAS_APP: Additional environment variable read by code (apps/ews_api/src/ews_api/bootstrap.py). Default: app.server.asgi:create_app. Values: see code. Optional.
# TAAS_APP=app.server.asgi:create_app

# TAAS_APP_NAME: Additional environment variable read by code (apps/ews_api/src/ews_api/bootstrap.py). Default: none. Values: see code. Optional.
# TAAS_APP_NAME=

# TAAS_RUNTIME: Additional environment variable read by code (libs/foundation/src/foundation/env/__init__.py). Default: unknown. Values: see code. Optional.
# TAAS_RUNTIME=unknown

# TAAS_WARN_IMPLICIT_SYNC_TO_THREAD: Additional environment variable read by code (libs/foundation/src/foundation/utils/warnings.py). Default: none. Values: see code. Optional.
# TAAS_WARN_IMPLICIT_SYNC_TO_THREAD=none

# TAAS_WARN_SIGNATURE_NAMESPACE_OVERRIDE: Additional environment variable read by code (libs/foundation/src/foundation/utils/warnings.py). Default: none. Values: see code. Optional.
# TAAS_WARN_SIGNATURE_NAMESPACE_OVERRIDE=none

# TAAS_WARN_SYNC_TO_THREAD_WITH_ASYNC: Additional environment variable read by code (libs/foundation/src/foundation/utils/warnings.py). Default: none. Values: see code. Optional.
# TAAS_WARN_SYNC_TO_THREAD_WITH_ASYNC=none

# TAAS_WARN_SYNC_TO_THREAD_WITH_GENERATOR: Additional environment variable read by code (libs/foundation/src/foundation/utils/warnings.py). Default: none. Values: see code. Optional.
# TAAS_WARN_SYNC_TO_THREAD_WITH_GENERATOR=none

# TABLE_PREFIX: Additional environment variable read by code (libs/db/src/db/models/config.py). Default: taas_. Values: see code. Optional.
# TABLE_PREFIX=taas_

# ───────────────────────────────────────────────────────────────────────────────
# 2. DATABASE — main PostgreSQL and Alembic settings — Main EWS database connection, pooling and migration controls.
# ───────────────────────────────────────────────────────────────────────────────

# DATABASE_URL: Async SQLAlchemy URL for the main database. Default: postgresql://localhost:5432/ews_db. Values: SQLAlchemy URL. Required.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/taas_next_test

# DATABASE_URL_SYNC: Synchronous database URL used by scripts/tools that cannot use async drivers. Default: none. Values: SQLAlchemy URL. Optional.
# DATABASE_URL_SYNC=postgresql://app:app@localhost:5432/taas_next_test

# DATABASE_DEBUG: Enable database debug mode. Default: False. Values: bool. Optional.
# DATABASE_DEBUG=false

# TAAS_DATABASE_DEBUG: Legacy prefixed database debug alias retained by older test env files. Default: none. Values: bool. Optional; prefer DATABASE_DEBUG.
# TAAS_DATABASE_DEBUG=false

# DATABASE_ECHO: Log SQL statements from SQLAlchemy. Default: False. Values: bool. Optional.
DATABASE_ECHO=false

# DATABASE_ECHO_POOL: Log SQLAlchemy pool checkouts/checkins. Default: False. Values: bool. Optional.
DATABASE_ECHO_POOL=false

# DATABASE_POOL_DISABLED: Disable explicit SQLAlchemy pool configuration. Default: False. Values: bool. Optional.
DATABASE_POOL_DISABLED=false

# DATABASE_POOL_SIZE: Base SQLAlchemy connection pool size. Default: 5. Values: integer. Optional.
DATABASE_POOL_SIZE=5

# DATABASE_MAX_POOL_OVERFLOW: Extra SQLAlchemy connections beyond pool size. Default: 30. Values: integer. Optional.
DATABASE_MAX_POOL_OVERFLOW=10

# DATABASE_POOL_TIMEOUT: Pool checkout timeout in seconds. Default: 30. Values: integer seconds. Optional.
DATABASE_POOL_TIMEOUT=30

# DATABASE_POOL_RECYCLE: Recycle pooled connections after this many seconds. Default: 300. Values: integer seconds. Optional.
# DATABASE_POOL_RECYCLE=300

# DATABASE_PRE_POOL_PING: Ping connections before checkout to survive restarts. Default: False. Values: bool. Optional.
# DATABASE_PRE_POOL_PING=false

# DATABASE_MIGRATION_ENABLED: Enable database migrations. Default: True. Values: bool. Optional.
# DATABASE_MIGRATION_ENABLED=true

# DATABASE_MIGRATION_CONFIG: Alembic config path. Default: libs/db/.../alembic.ini. Values: path. Optional.
# DATABASE_MIGRATION_CONFIG=

# DATABASE_MIGRATION_PATH: Alembic script directory. Default: libs/db/.../migrations. Values: path. Optional.
# DATABASE_MIGRATION_PATH=

# DATABASE_MIGRATION_DDL_VERSION_TABLE: Alembic version table name. Default: ddl_version. Values: string. Optional.
# DATABASE_MIGRATION_DDL_VERSION_TABLE=ddl_version

# DATABASE_FIXTURE_PATH: JSON fixture directory. Default: libs/db/.../fixtures. Values: path. Optional.
# DATABASE_FIXTURE_PATH=

# ───────────────────────────────────────────────────────────────────────────────
# 3. WORKERS AND SAQ — background processes and health ports — Settings for EWS worker, outbox worker and legacy SAQ knobs kept for compatibility.
# ───────────────────────────────────────────────────────────────────────────────

# HEALTH_CHECK_ENABLE: Enable worker health-check HTTP server. Default: True. Values: bool. Optional.
# HEALTH_CHECK_ENABLE=true

# WORKER_LISTEN_PORT: Worker health-check HTTP port; outbox script defaults to 7110. Default: 7000. Values: port. Optional.
# WORKER_LISTEN_PORT=7110

# HEALTH_CHECK_INTERVAL: Worker health log interval in seconds. Default: 15. Values: integer seconds. Optional.
# HEALTH_CHECK_INTERVAL=15

# SAQ_USE_SERVER_LIFESPAN: Legacy SAQ lifespan switch retained by local env files. Default: none. Values: bool. Optional.
SAQ_USE_SERVER_LIFESPAN=false

# SAQ_WEB_ENABLED: Legacy SAQ web UI switch retained by local env files. Default: none. Values: bool. Optional.
SAQ_WEB_ENABLED=true

# SAQ_PROCESSES: Legacy SAQ process count retained by local env files. Default: none. Values: integer. Optional.
SAQ_PROCESSES=1

# SAQ_CONCURRENCY: Legacy SAQ per-process concurrency retained by local env files. Default: none. Values: integer. Optional.
SAQ_CONCURRENCY=10

# ───────────────────────────────────────────────────────────────────────────────
# 4. REDIS, CACHE, RATE LIMIT AND IDEMPOTENCY — local infra uses cache:16379 and store:16380 — Redis-backed cache, rate limiter, websocket pub/sub, distributed lock and idempotency settings.
# ───────────────────────────────────────────────────────────────────────────────

# TAAS_CACHE_ENABLED: Enable response/object cache adapter. Default: True. Values: bool. Optional.
# TAAS_CACHE_ENABLED=true

# TAAS_CACHE_PROVIDER: Cache backend provider. Default: redis. Values: redis | memory. Optional.
# TAAS_CACHE_PROVIDER=redis

# TAAS_CACHE_REDIS_HOST: Cache Redis URL or host; local infra cache is localhost:16379. Default: redis://redis:6379/0. Values: redis URL or host:port. Optional.
TAAS_CACHE_REDIS_HOST=redis://localhost:16379/15

# TAAS_CACHE_REDIS_PASSWORD: Cache Redis password. Default: empty. Values: secret string. Optional.
# TAAS_CACHE_REDIS_PASSWORD=change-me

# TAAS_CACHE_REDIS_MASTER_NAME: Cache Redis Sentinel master name. Default: cache-master. Values: string. Optional.
# TAAS_CACHE_REDIS_MASTER_NAME=cache-master

# TAAS_CACHE_TTL: Default cache TTL in seconds. Default: 60. Values: integer seconds. Optional.
# TAAS_CACHE_TTL=60

# TAAS_CACHE_KEY_PREFIX: Cache key namespace prefix. Default: cache. Values: string. Optional.
# TAAS_CACHE_KEY_PREFIX=cache

# CACHE_ENABLED: Legacy in-process API cache switch. Default: True. Values: bool. Optional.
# CACHE_ENABLED=true

# API_CACHE_PREFIX: Legacy in-process API cache prefix. Default: api_cache. Values: string. Optional.
# API_CACHE_PREFIX=api_cache

# TAAS_RATE_LIMIT_ENABLED: Enable HTTP rate limiter. Default: True. Values: bool. Optional.
TAAS_RATE_LIMIT_ENABLED=true

# TAAS_RATE_LIMIT_PROVIDER: Rate limit storage provider. Default: redis. Values: redis | memory. Optional.
# TAAS_RATE_LIMIT_PROVIDER=redis

# TAAS_RATE_LIMIT_REDIS_HOST: Rate-limit Redis URL or host; local infra store is localhost:16380. Default: redis://redis:6379/0. Values: redis URL or host:port. Optional.
TAAS_RATE_LIMIT_REDIS_HOST=redis://localhost:16380/15

# TAAS_RATE_LIMIT_REDIS_PASSWORD: Rate-limit Redis password. Default: empty. Values: secret string. Optional.
# TAAS_RATE_LIMIT_REDIS_PASSWORD=change-me

# TAAS_RATE_LIMIT_REDIS_MASTER_NAME: Rate-limit Redis Sentinel master name. Default: rate-master. Values: string. Optional.
# TAAS_RATE_LIMIT_REDIS_MASTER_NAME=rate-master

# TAAS_RATE_LIMIT_DEFAULT: Default route limits where no decorator overrides. Default: ["5/minute"]. Values: JSON list of limits. Optional.
# TAAS_RATE_LIMIT_DEFAULT=["30000/minute"]

# TAAS_RATE_LIMIT_REQUEST_PER_MINUTE: Default requests per minute budget. Default: 30000. Values: integer. Optional.
TAAS_RATE_LIMIT_REQUEST_PER_MINUTE=30000

# TAAS_RATE_LIMIT_TTL: Default rate limit window in seconds. Default: 60. Values: integer seconds. Optional.
# TAAS_RATE_LIMIT_TTL=60

# TAAS_RATE_LIMIT_KEY_PREFIX: Rate-limit Redis key prefix. Default: rate_limit. Values: string. Optional.
# TAAS_RATE_LIMIT_KEY_PREFIX=rate_limit

# TAAS_WEBSOCKET_DEBUG: Enable websocket/socket.io debug logging. Default: False. Values: bool. Optional.
TAAS_WEBSOCKET_DEBUG=false

# TAAS_WEBSOCKET_PROVIDER: Websocket pub/sub provider. Default: redis. Values: redis | memory. Optional.
# TAAS_WEBSOCKET_PROVIDER=redis

# TAAS_WEBSOCKET_REDIS_HOST: Websocket Redis URL or host; local infra store is localhost:16380. Default: redis://redis:6379/0. Values: redis URL or host:port. Optional.
TAAS_WEBSOCKET_REDIS_HOST=redis://localhost:16380/15

# TAAS_WEBSOCKET_REDIS_PASSWORD: Websocket Redis password. Default: empty. Values: secret string. Optional.
# TAAS_WEBSOCKET_REDIS_PASSWORD=change-me

# TAAS_WEBSOCKET_REDIS_MASTER_NAME: Websocket Redis Sentinel master name. Default: pubsub-master. Values: string. Optional.
# TAAS_WEBSOCKET_REDIS_MASTER_NAME=pubsub-master

# TAAS_WEBSOCKET_SOCKETIO_PATH: Socket.IO mount path. Default: socket.io. Values: path fragment. Optional.
# TAAS_WEBSOCKET_SOCKETIO_PATH=socket.io

# TAAS_WEBSOCKET_CHANNEL_PREFIX: Websocket pub/sub channel prefix. Default: wss. Values: string. Optional.
# TAAS_WEBSOCKET_CHANNEL_PREFIX=wss

# TAAS_WEBSOCKET_PING_INTERVAL: Socket.IO ping interval in seconds. Default: 25. Values: integer seconds. Optional.
# TAAS_WEBSOCKET_PING_INTERVAL=25

# TAAS_WEBSOCKET_PING_TIMEOUT: Socket.IO ping timeout in seconds. Default: 20. Values: integer seconds. Optional.
# TAAS_WEBSOCKET_PING_TIMEOUT=20

# TAAS_DISTRIBUTED_LOCK_ENABLED: Enable distributed lock adapter. Default: False. Values: bool. Optional.
# TAAS_DISTRIBUTED_LOCK_ENABLED=false

# TAAS_DISTRIBUTED_LOCK_PROVIDER: Distributed lock provider. Default: redis. Values: redis. Optional.
# TAAS_DISTRIBUTED_LOCK_PROVIDER=redis

# TAAS_DISTRIBUTED_LOCK_REDIS_HOST: Distributed-lock Redis URL or host; local infra store is localhost:16380. Default: redis://redis:6379/0. Values: redis URL or host:port. Optional.
# TAAS_DISTRIBUTED_LOCK_REDIS_HOST=redis://localhost:16380/0

# TAAS_DISTRIBUTED_LOCK_REDIS_PASSWORD: Distributed-lock Redis password. Default: empty. Values: secret string. Optional.
# TAAS_DISTRIBUTED_LOCK_REDIS_PASSWORD=change-me

# TAAS_DISTRIBUTED_LOCK_REDIS_MASTER_NAME: Distributed-lock Redis Sentinel master name. Default: lock-master. Values: string. Optional.
# TAAS_DISTRIBUTED_LOCK_REDIS_MASTER_NAME=lock-master

# TAAS_DISTRIBUTED_LOCK_TTL: Distributed lock TTL in seconds. Default: 60. Values: integer seconds. Optional.
# TAAS_DISTRIBUTED_LOCK_TTL=60

# TAAS_DISTRIBUTED_LOCK_KEY_PREFIX: Distributed lock key prefix. Default: distributed_lock. Values: string. Optional.
# TAAS_DISTRIBUTED_LOCK_KEY_PREFIX=distributed_lock

# IDEMPOTENCY_BACKEND: Idempotency backend. Default: postgres. Values: postgres | redis. Optional.
# IDEMPOTENCY_BACKEND=postgres

# IDEMPOTENCY_REDIS_HOST: Idempotency Redis URL or host; local infra store is localhost:16380. Default: cache Redis when empty. Values: redis URL or host:port. Optional.
IDEMPOTENCY_REDIS_HOST=redis://localhost:16380/15

# IDEMPOTENCY_REDIS_PASSWORD: Idempotency Redis password. Default: cache Redis password when empty. Values: secret string. Optional.
# IDEMPOTENCY_REDIS_PASSWORD=change-me

# IDEMPOTENCY_REDIS_KEY_PREFIX: Idempotency Redis key prefix. Default: idempotency. Values: string. Optional.
# IDEMPOTENCY_REDIS_KEY_PREFIX=idempotency

# IDEMPOTENCY_TTL_DAYS: Idempotency retention in days. Default: 30. Values: integer days. Optional.
# IDEMPOTENCY_TTL_DAYS=30

# IDEMPOTENCY_CLEANUP_BATCH_SIZE: Postgres idempotency cleanup batch size. Default: 500. Values: integer. Optional.
# IDEMPOTENCY_CLEANUP_BATCH_SIZE=500

# IDEMPOTENCY_ENABLE_METRICS: Enable idempotency metrics counters. Default: True. Values: bool. Optional.
# IDEMPOTENCY_ENABLE_METRICS=true

# IDEMPOTENCY_LOG_DUPLICATES: Log duplicate idempotency events. Default: True. Values: bool. Optional.
# IDEMPOTENCY_LOG_DUPLICATES=true

# IDEMPOTENCY_STRICT_MODE: Raise on duplicate events instead of silent skip. Default: False. Values: bool. Optional.
# IDEMPOTENCY_STRICT_MODE=false

# IDEMPOTENCY_LEASE_MS: Redis idempotency lease duration in milliseconds. Default: 60000. Values: integer ms. Optional.
# IDEMPOTENCY_LEASE_MS=60000

# ───────────────────────────────────────────────────────────────────────────────
# 5. MESSAGING, KAFKA, OUTBOX AND DLQ — broker integration and reliable delivery — Kafka/FastStream messaging, schema registry, outbox relay and dead-letter queue controls.
# ───────────────────────────────────────────────────────────────────────────────

# PROVIDER_TYPE: Messaging provider selected by foundation messaging settings. Default: kafka. Values: kafka | faststream-kafka | redis | sqs | nats. Optional.
# PROVIDER_TYPE=kafka

# PUBSUB_SERVICE_PROVIDER: Legacy provider alias used by older FastStream tests/config. Default: none. Values: string. Optional.
# PUBSUB_SERVICE_PROVIDER=faststream-kafka

# MESSAGING_DEBUG: Enable messaging debug mode. Default: False. Values: bool. Optional.
# MESSAGING_DEBUG=false

# MESSAGE_ENCODING: Wire encoding for messages. Default: msgpack. Values: json | msgpack | protobuf | schema-registry-avro. Optional.
# MESSAGE_ENCODING=schema-registry-avro

# MESSAGE_FIELD_ENCODING: Field encoding when schema-registry-avro is used. Default: msgpack. Values: json | msgpack. Optional.
# MESSAGE_FIELD_ENCODING=msgpack

# CONSUMER_ENABLED: Enable messaging consumers in worker processes. Default: True. Values: bool. Optional.
# CONSUMER_ENABLED=false

# CONSUMER_ENABLE: Legacy consumer-enable alias exported by start scripts. Default: none. Values: bool. Optional.
# CONSUMER_ENABLE=false

# MESSAGING_CONSUMER_ENABLE: Legacy API consumer-enable alias exported by start scripts. Default: none. Values: bool. Optional.
# MESSAGING_CONSUMER_ENABLE=false

# CONSUMER_CHANNELS: Static topic/channel subscriptions for worker consumers. Default: []. Values: JSON list or comma list. Optional.
# CONSUMER_CHANNELS=[]

# CHANNEL_CONSISTENCY_CHECK_ENABLED: Validate declared consumer channels against routing. Default: True. Values: bool. Optional.
# CHANNEL_CONSISTENCY_CHECK_ENABLED=true

# MAX_RETRIES: Messaging retry budget before broker DLQ. Default: 3. Values: integer. Optional.
# MAX_RETRIES=3

# RETRY_BACKOFF_MS: Messaging retry backoff in milliseconds. Default: 1000. Values: integer ms. Optional.
# RETRY_BACKOFF_MS=1000

# DLQ_ENABLED: Enable broker-level DLQ publishing. Default: True. Values: bool. Optional.
# DLQ_ENABLED=true

# DLQ_ENABLE: Legacy broker DLQ switch retained by older env files. Default: none. Values: bool. Optional; prefer DLQ_ENABLED.
# DLQ_ENABLE=true

# DLQ_TOPIC: Broker topic/channel for DLQ envelopes. Default: dlq.events. Values: topic. Optional.
# DLQ_TOPIC=dlq.events

# KAFKA_BOOTSTRAP_SERVERS: Comma-separated Kafka broker addresses. Default: localhost:29092. Values: host:port list. Required when provider is Kafka.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# KAFKA_CONSUMER_GROUP_ID: Kafka consumer group id. Default: eworksuite-worker-group. Values: string. Optional.
# KAFKA_CONSUMER_GROUP_ID=eworksuite-worker-group

# KAFKA_CONSUMER_MAX_WORKERS: Kafka handler worker concurrency. Default: 1. Values: integer. Optional.
# KAFKA_CONSUMER_MAX_WORKERS=1

# KAFKA_GRACEFUL_SHUTDOWN_TIMEOUT: Kafka graceful shutdown timeout in seconds. Default: 5. Values: integer seconds. Optional.
# KAFKA_GRACEFUL_SHUTDOWN_TIMEOUT=5

# KAFKA_MESSAGE_CONSUMING_FROM_BEGINING: Consume from earliest when a group has no offset; name kept as implemented. Default: True. Values: bool. Optional.
# KAFKA_MESSAGE_CONSUMING_FROM_BEGINING=true

# KAFKA_AUTO_OFFSET_RESET: Kafka offset reset policy used by current consumers. Default: none/earliest from provider. Values: latest | earliest | none. Optional.
# KAFKA_AUTO_OFFSET_RESET=earliest

# KAFKA_ENABLE_AUTO_COMMIT: Let Kafka client auto-commit offsets. Default: False. Values: bool. Optional.
# KAFKA_ENABLE_AUTO_COMMIT=false

# KAFKA_MAX_POLL_RECORDS: Maximum records per poll. Default: 10. Values: integer. Optional.
# KAFKA_MAX_POLL_RECORDS=10

# KAFKA_SESSION_TIMEOUT_MS: Kafka session timeout. Default: 45000. Values: integer ms. Optional.
# KAFKA_SESSION_TIMEOUT_MS=45000

# KAFKA_HEARTBEAT_INTERVAL_MS: Kafka heartbeat interval. Default: 15000. Values: integer ms. Optional.
# KAFKA_HEARTBEAT_INTERVAL_MS=15000

# KAFKA_MAX_POLL_INTERVAL_MS: Kafka maximum poll interval. Default: 900000. Values: integer ms. Optional.
# KAFKA_MAX_POLL_INTERVAL_MS=900000

# KAFKA_RETRY_BACKOFF_MS: Kafka reconnect retry backoff. Default: 1000. Values: integer ms. Optional.
# KAFKA_RETRY_BACKOFF_MS=1000

# KAFKA_METADATA_MAX_AGE_MS: Kafka metadata refresh interval. Default: 300000. Values: integer ms. Optional.
# KAFKA_METADATA_MAX_AGE_MS=300000

# KAFKA_REQUEST_TIMEOUT_MS: Kafka request timeout. Default: 40000. Values: integer ms. Optional.
# KAFKA_REQUEST_TIMEOUT_MS=40000

# KAFKA_LOG_THROTTLE_ENABLED: Throttle repeated aiokafka connection errors. Default: True. Values: bool. Optional.
# KAFKA_LOG_THROTTLE_ENABLED=true

# KAFKA_LOG_THROTTLE_BURST: Repeated Kafka log lines before throttling. Default: 1. Values: integer. Optional.
# KAFKA_LOG_THROTTLE_BURST=1

# KAFKA_LOG_THROTTLE_INTERVAL_S: Kafka throttled-summary interval. Default: 60. Values: integer seconds. Optional.
# KAFKA_LOG_THROTTLE_INTERVAL_S=60

# KAFKA_SECURITY_PROTOCOL: Kafka transport/auth protocol. Default: none (PLAINTEXT). Values: PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL. Optional/required for secured Kafka.
# KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# KAFKA_SASL_MECHANISM: Kafka SASL mechanism. Default: none. Values: PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512 | GSSAPI | OAUTHBEARER. Required for SASL_* protocols.
# KAFKA_SASL_MECHANISM=

# KAFKA_SASL_USERNAME: Kafka SASL username. Default: none. Values: string. Required for password SASL.
# KAFKA_SASL_USERNAME=change-me

# KAFKA_SASL_PASSWORD: Kafka SASL password. Default: none. Values: secret string. Required for password SASL.
# KAFKA_SASL_PASSWORD=change-me

# KAFKA_SSL_CA_LOCATION: Path to Kafka TLS CA bundle. Default: none. Values: path. Optional.
# KAFKA_SSL_CA_LOCATION=

# KAFKA_CA_DATA: Inline Kafka TLS CA bundle; prefer secret manager in production. Default: none. Values: PEM or base64 PEM. Optional.
# KAFKA_CA_DATA=change-me

# KAFKA_SSL_CHECK_HOSTNAME: Validate broker certificate hostname. Default: True. Values: bool. Optional.
# KAFKA_SSL_CHECK_HOSTNAME=true

# KAFKA_SSL_STRICT_VERIFY: Use Python strict X.509 verification. Default: True. Values: bool. Optional.
# KAFKA_SSL_STRICT_VERIFY=true

# KAFKA_SCHEMA_REGISTRY_URL: Confluent Schema Registry URL. Default: none. Values: URL. Required for schema-registry-avro.
# KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# KAFKA_SCHEMA_REGISTRY_USERNAME: Schema Registry basic-auth username. Default: none. Values: string. Optional.
# KAFKA_SCHEMA_REGISTRY_USERNAME=change-me

# KAFKA_SCHEMA_REGISTRY_PASSWORD: Schema Registry basic-auth password. Default: none. Values: secret string. Optional.
# KAFKA_SCHEMA_REGISTRY_PASSWORD=change-me

# KAFKA_HEALTH_CHECK_INTERVAL_SECONDS: Kafka health-check interval used by local env. Default: none. Values: integer seconds. Optional.
# KAFKA_HEALTH_CHECK_INTERVAL_SECONDS=60

# OUTBOX_ENABLE: Legacy messaging outbox switch. Default: False. Values: bool. Optional.
# OUTBOX_ENABLE=false

# OUTBOX_POLLER_ENABLE: Enable worker outbox poller. Default: False/True by worker. Values: bool. Optional.
# OUTBOX_POLLER_ENABLE=true

# OUTBOX_ENABLED: Enable transactional outbox relay policy. Default: True. Values: bool. Optional.
# OUTBOX_ENABLED=true

# OUTBOX_POLL_OUTBOXES: Comma-separated outbox names to relay; empty means all. Default: empty. Values: comma list. Optional.
# OUTBOX_POLL_OUTBOXES=

# OUTBOX_POLL_STRATEGY: Outbox polling strategy. Default: adaptive. Values: fixed | adaptive | notify. Optional.
# OUTBOX_POLL_STRATEGY=adaptive

# OUTBOX_FIXED_POLL_INTERVAL_MS: Fixed poll sleep. Default: 1000. Values: integer ms. Optional.
# OUTBOX_FIXED_POLL_INTERVAL_MS=1000

# OUTBOX_MIN_POLL_INTERVAL_MS: Adaptive min poll sleep. Default: 50. Values: integer ms. Optional.
# OUTBOX_MIN_POLL_INTERVAL_MS=50

# OUTBOX_MAX_POLL_INTERVAL_MS: Adaptive max poll sleep. Default: 2000. Values: integer ms. Optional.
# OUTBOX_MAX_POLL_INTERVAL_MS=2000

# OUTBOX_INITIAL_POLL_INTERVAL_MS: Initial adaptive poll sleep. Default: 200. Values: integer ms. Optional.
# OUTBOX_INITIAL_POLL_INTERVAL_MS=200

# OUTBOX_BACKOFF_GROWTH_FACTOR: Adaptive backoff growth factor. Default: 3.0. Values: float > 1. Optional.
# OUTBOX_BACKOFF_GROWTH_FACTOR=3.0

# OUTBOX_DRAIN_THRESHOLD_RATIO: Immediate-drain threshold ratio. Default: 1.0. Values: float. Optional.
# OUTBOX_DRAIN_THRESHOLD_RATIO=1.0

# OUTBOX_NOTIFY_CHANNEL: Postgres LISTEN/NOTIFY channel. Default: resiliant_outbox. Values: string. Optional.
# OUTBOX_NOTIFY_CHANNEL=resiliant_outbox

# OUTBOX_NOTIFY_DSN: Dedicated LISTEN connection string; empty derives from DATABASE_URL. Default: empty. Values: SQLAlchemy URL. Optional.
# OUTBOX_NOTIFY_DSN=change-me

# OUTBOX_BATCH_SIZE: Rows claimed per relay poll. Default: 100. Values: integer. Optional.
# OUTBOX_BATCH_SIZE=100

# OUTBOX_CONCURRENT_WORKERS: Relay loops per process. Default: 1. Values: integer. Optional.
# OUTBOX_CONCURRENT_WORKERS=1

# OUTBOX_MAX_RETRIES: Outbox retry budget. Default: 10. Values: integer. Optional.
# OUTBOX_MAX_RETRIES=10

# OUTBOX_RETRY_BACKOFF_MULTIPLIER: Outbox retry exponent multiplier. Default: 2.0. Values: float. Optional.
# OUTBOX_RETRY_BACKOFF_MULTIPLIER=2.0

# OUTBOX_RETRY_MAX_BACKOFF_MS: Outbox retry max backoff. Default: 300000. Values: integer ms. Optional.
# OUTBOX_RETRY_MAX_BACKOFF_MS=300000

# OUTBOX_DISPATCH_TIMEOUT_MS: Outbox dispatch timeout. Default: 30000. Values: integer ms. Optional.
# OUTBOX_DISPATCH_TIMEOUT_MS=30000

# OUTBOX_PRESERVE_ORDERING: Preserve per-channel ordering. Default: True. Values: bool. Optional.
# OUTBOX_PRESERVE_ORDERING=true

# OUTBOX_BREAKER_FAILURE_THRESHOLD: Failures before outbox circuit breaker opens. Default: 3. Values: integer. Optional.
# OUTBOX_BREAKER_FAILURE_THRESHOLD=3

# OUTBOX_BREAKER_COOLDOWN_MS: Outbox circuit breaker cooldown. Default: 5000. Values: integer ms. Optional.
# OUTBOX_BREAKER_COOLDOWN_MS=5000

# OUTBOX_RETENTION_DAYS: Published outbox row retention. Default: 7. Values: integer days. Optional.
# OUTBOX_RETENTION_DAYS=7

# OUTBOX_ENABLE_METRICS: Enable outbox metrics logs. Default: True. Values: bool. Optional.
# OUTBOX_ENABLE_METRICS=true

# OUTBOX_METRICS_LOG_INTERVAL_MS: Outbox metrics log interval. Default: 60000. Values: integer ms. Optional.
# OUTBOX_METRICS_LOG_INTERVAL_MS=60000

# OUTBOX_DEFAULT_ROUTING: Default message routing strategy. Default: outbox. Values: outbox | direct. Optional.
# OUTBOX_DEFAULT_ROUTING=outbox

# OUTBOX_DIRECT_CHANNEL_ROUTING: Channels published directly instead of through outbox. Default: empty. Values: comma list. Optional.
# OUTBOX_DIRECT_CHANNEL_ROUTING=

# OUTBOX_OUTBOX_CHANNEL: Single channel forced through outbox routing. Default: empty. Values: channel. Optional.
# OUTBOX_OUTBOX_CHANNEL=

# DLQ_BATCH_SIZE: Database DLQ retry batch size. Default: 50. Values: integer. Optional.
# DLQ_BATCH_SIZE=50

# DLQ_PAGE_SIZE: Database DLQ list page size. Default: 100. Values: integer. Optional.
# DLQ_PAGE_SIZE=100

# DLQ_MAX_RETRIES: Database DLQ default retry budget. Default: 3. Values: integer. Optional.
# DLQ_MAX_RETRIES=3

# DLQ_RETRY_BACKOFF_MULTIPLIER: Database DLQ retry multiplier. Default: 2.0. Values: float. Optional.
# DLQ_RETRY_BACKOFF_MULTIPLIER=2.0

# DLQ_RETRY_MAX_INTERVAL_MS: Database DLQ retry cap. Default: 60000. Values: integer ms. Optional.
# DLQ_RETRY_MAX_INTERVAL_MS=60000

# DLQ_CLAIM_TIMEOUT_MS: Database DLQ processing lease timeout. Default: 300000. Values: integer ms. Optional.
# DLQ_CLAIM_TIMEOUT_MS=300000

# DLQ_ARCHIVE_AFTER_DAYS: Archive terminal DLQ rows after days. Default: 30. Values: integer days. Optional.
# DLQ_ARCHIVE_AFTER_DAYS=30

# DLQ_HANDLER_MAX_RETRIES: Per-handler DLQ retry overrides. Default: empty. Values: Handler:limit list or JSON object. Optional.
# DLQ_HANDLER_MAX_RETRIES=

# EVENT_PROCESSOR_ENABLE_DLQ: Additional environment variable read by code (libs/foundation/src/foundation/messaging/events/event_processor_settings.py). Default: True. Values: see code. Optional.
# EVENT_PROCESSOR_ENABLE_DLQ=true

# EVENT_PROCESSOR_ENABLE_IDEMPOTENCY: Additional environment variable read by code (libs/foundation/src/foundation/messaging/events/event_processor_settings.py). Default: False. Values: see code. Optional.
# EVENT_PROCESSOR_ENABLE_IDEMPOTENCY=false

# EVENT_PROCESSOR_ENABLE_METRICS: Additional environment variable read by code (libs/foundation/src/foundation/messaging/events/event_processor_settings.py). Default: True. Values: see code. Optional.
# EVENT_PROCESSOR_ENABLE_METRICS=true

# EVENT_PROCESSOR_ENABLE_PARALLEL_EXECUTION: Additional environment variable read by code (libs/foundation/src/foundation/messaging/events/event_processor_settings.py). Default: False. Values: see code. Optional.
# EVENT_PROCESSOR_ENABLE_PARALLEL_EXECUTION=false

# EVENT_PROCESSOR_ENABLE_TRACING: Additional environment variable read by code (libs/foundation/src/foundation/messaging/events/event_processor_settings.py). Default: True. Values: see code. Optional.
# EVENT_PROCESSOR_ENABLE_TRACING=true

# EVENT_PROCESSOR_MAX_CONCURRENT_TASKS: Additional environment variable read by code (libs/foundation/src/foundation/messaging/events/event_processor_settings.py). Default: 10. Values: see code. Optional.
# EVENT_PROCESSOR_MAX_CONCURRENT_TASKS=10

# EVENT_PROCESSOR_MAX_RETRIES: Additional environment variable read by code (libs/foundation/src/foundation/messaging/events/event_processor_settings.py). Default: 3. Values: see code. Optional.
# EVENT_PROCESSOR_MAX_RETRIES=3

# EVENT_PROCESSOR_RETRY_BACKOFF_MS: Additional environment variable read by code (libs/foundation/src/foundation/messaging/events/event_processor_settings.py). Default: 1000. Values: see code. Optional.
# EVENT_PROCESSOR_RETRY_BACKOFF_MS=1000

# EVENT_PROCESSOR_RETRY_ENABLED: Additional environment variable read by code (libs/foundation/src/foundation/messaging/events/event_processor_settings.py). Default: False. Values: see code. Optional.
# EVENT_PROCESSOR_RETRY_ENABLED=false

# EVENT_PROCESSOR_RETRY_EXPONENTIAL_BASE: Additional environment variable read by code (libs/foundation/src/foundation/messaging/events/event_processor_settings.py). Default: 2.0. Values: see code. Optional.
# EVENT_PROCESSOR_RETRY_EXPONENTIAL_BASE=2.0

# EVENT_PROCESSOR_RETRY_MAX_DELAY_MS: Additional environment variable read by code (libs/foundation/src/foundation/messaging/events/event_processor_settings.py). Default: 60000. Values: see code. Optional.
# EVENT_PROCESSOR_RETRY_MAX_DELAY_MS=60000

# EVENT_PROCESSOR_RETRY_POLICY_NAME: Additional environment variable read by code (libs/foundation/src/foundation/messaging/events/event_processor_settings.py). Default: event_processor. Values: see code. Optional.
# EVENT_PROCESSOR_RETRY_POLICY_NAME=event_processor

# EVENT_PROCESSOR_RETRY_WAIT_STRATEGY: Additional environment variable read by code (libs/foundation/src/foundation/messaging/events/event_processor_settings.py). Default: exponential. Values: see code. Optional.
# EVENT_PROCESSOR_RETRY_WAIT_STRATEGY=exponential

# ───────────────────────────────────────────────────────────────────────────────
# 6. IAM, KEYCLOAK AND OAUTH — authentication and identity integrations — IAM policy, Keycloak realm/client settings and OAuth client credentials.
# ───────────────────────────────────────────────────────────────────────────────

# IAM_USE_EMAIL_AS_USERNAME: Use email as IAM username. Default: True. Values: bool. Optional.
# IAM_USE_EMAIL_AS_USERNAME=true

# IAM_SAAS_ENABLED: Require organization context during IAM signup. Default: False. Values: bool. Optional.
# IAM_SAAS_ENABLED=false

# IAM_PASSWORD_MIN_LENGTH: Minimum password length. Default: 8. Values: integer. Optional.
# IAM_PASSWORD_MIN_LENGTH=8

# IAM_PASSWORD_MAX_LENGTH: Maximum password length. Default: 64. Values: integer. Optional.
# IAM_PASSWORD_MAX_LENGTH=64

# IAM_PASSWORD_REQUIRE_UPPERCASE: Require uppercase password character. Default: True. Values: bool. Optional.
# IAM_PASSWORD_REQUIRE_UPPERCASE=true

# IAM_PASSWORD_REQUIRE_LOWERCASE: Require lowercase password character. Default: True. Values: bool. Optional.
# IAM_PASSWORD_REQUIRE_LOWERCASE=true

# IAM_PASSWORD_REQUIRE_NUMBERS: Require numeric password character. Default: True. Values: bool. Optional.
# IAM_PASSWORD_REQUIRE_NUMBERS=true

# IAM_PASSWORD_REQUIRE_SPECIAL_CHARACTERS: Require special password character. Default: True. Values: bool. Optional.
# IAM_PASSWORD_REQUIRE_SPECIAL_CHARACTERS=true

# IAM_SIGNUP_REQUIRED_FIELDS: Fields required during signup. Default: [email,password,first_name,last_name]. Values: JSON list or comma list. Optional.
# IAM_SIGNUP_REQUIRED_FIELDS=["email","password","first_name","last_name"]

# SAAS_ENABLED: SaaS registration behavior for legacy SaaS settings. Default: True. Values: bool. Optional.
# SAAS_ENABLED=true

# EMAIL_AS_USERNAME: Use email as username for legacy SaaS settings. Default: False. Values: bool. Optional.
# EMAIL_AS_USERNAME=false

# KEYCLOAK_HOST: Keycloak base URL. Default: http://localhost:9090. Values: URL. Required for Keycloak IAM.
# KEYCLOAK_HOST=http://localhost:9090

# KEYCLOAK_REALM: Keycloak realm name. Default: eworksuite. Values: string. Required for Keycloak IAM.
# KEYCLOAK_REALM=eworksuite

# KEYCLOAK_CLIENT_ID: Default Keycloak client id. Default: eworksuite-web. Values: string. Required for Keycloak IAM.
# KEYCLOAK_CLIENT_ID=eworksuite-web

# KEYCLOAK_LOGIN_CLIENT_ID: Keycloak login flow client id. Default: eworksuite-web. Values: string. Required for login flow.
# KEYCLOAK_LOGIN_CLIENT_ID=eworksuite-web

# KEYCLOAK_LOGIN_CLIENT_SECRET: Keycloak login client secret. Default: none. Values: secret string. Required for login flow.
# KEYCLOAK_LOGIN_CLIENT_SECRET=change-me

# KEYCLOAK_OTP_CLIENT_ID: Keycloak OTP client id. Default: none. Values: string. Optional.
# KEYCLOAK_OTP_CLIENT_ID=eworksuite-otp

# KEYCLOAK_OTP_CLIENT_SECRET: Keycloak OTP client secret. Default: none. Values: secret string. Optional.
# KEYCLOAK_OTP_CLIENT_SECRET=change-me

# KEYCLOAK_ADMIN_USER: Keycloak admin username. Default: none. Values: string. Required for admin operations.
# KEYCLOAK_ADMIN_USER=admin

# KEYCLOAK_ADMIN_SECRET: Keycloak admin password/secret. Default: none. Values: secret string. Required for admin operations.
# KEYCLOAK_ADMIN_SECRET=change-me

# KEYCLOAK_REDIRECT_URL: Redirect URL after Keycloak auth. Default: none. Values: URL. Optional.
# KEYCLOAK_REDIRECT_URL=http://localhost:8191/auth/callback

# KEYCLOAK_SSL_VERIFY: Verify Keycloak TLS certificate. Default: False. Values: bool. Optional.
# KEYCLOAK_SSL_VERIFY=false

# KEYCLOAK_DATABASE_URL: Async SQLAlchemy URL for a separate Keycloak database when used. Default: main DATABASE_* defaults. Values: SQLAlchemy URL. Optional.
# KEYCLOAK_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/keycloak

# KEYCLOAK_DATABASE_ECHO: Log Keycloak DB SQL statements. Default: False. Values: bool. Optional.
# KEYCLOAK_DATABASE_ECHO=false

# KEYCLOAK_DATABASE_ECHO_POOL: Log Keycloak DB pool operations. Default: False. Values: bool. Optional.
# KEYCLOAK_DATABASE_ECHO_POOL=false

# KEYCLOAK_DATABASE_POOL_DISABLED: Disable Keycloak DB pool configuration. Default: False. Values: bool. Optional.
# KEYCLOAK_DATABASE_POOL_DISABLED=false

# KEYCLOAK_DATABASE_POOL_SIZE: Keycloak DB pool size. Default: 5. Values: integer. Optional.
# KEYCLOAK_DATABASE_POOL_SIZE=5

# KEYCLOAK_DATABASE_MAX_POOL_OVERFLOW: Keycloak DB max pool overflow. Default: 30. Values: integer. Optional.
# KEYCLOAK_DATABASE_MAX_POOL_OVERFLOW=10

# KEYCLOAK_DATABASE_POOL_TIMEOUT: Keycloak DB checkout timeout seconds. Default: 30. Values: integer seconds. Optional.
# KEYCLOAK_DATABASE_POOL_TIMEOUT=30

# KEYCLOAK_POSTGRES_HOST: Legacy Keycloak PostgreSQL host kept for compatibility. Default: none. Values: host. Optional.
# KEYCLOAK_POSTGRES_HOST=localhost

# KEYCLOAK_POSTGRES_PORT: Legacy Keycloak PostgreSQL port kept for compatibility. Default: 5432. Values: port. Optional.
# KEYCLOAK_POSTGRES_PORT=5432

# KEYCLOAK_POSTGRES_USER: Legacy Keycloak PostgreSQL user kept for compatibility. Default: postgres. Values: string. Optional.
# KEYCLOAK_POSTGRES_USER=app

# KEYCLOAK_DB: Legacy Keycloak database name kept for compatibility. Default: keycloak. Values: string. Optional.
# KEYCLOAK_DB=keycloak

# KEYCLOAK_BUSINESS_IMPERSONATE_CLIENT_ID: Business impersonation Keycloak client id referenced by service code. Default: none. Values: string. Required if impersonation flow is used.
# KEYCLOAK_BUSINESS_IMPERSONATE_CLIENT_ID=eworksuite-business-impersonate

# KEYCLOAK_BUSINESS_IMPERSONATE_CLIENT_SECRET: Business impersonation Keycloak client secret referenced by service code. Default: none. Values: secret string. Required if impersonation flow is used.
# KEYCLOAK_BUSINESS_IMPERSONATE_CLIENT_SECRET=change-me

# GOOGLE_OAUTH2_CLIENT_ID: Google OAuth2 client id used by current AppSettings. Default: empty. Values: string. Optional.
# GOOGLE_OAUTH2_CLIENT_ID=

# GOOGLE_OAUTH2_CLIENT_SECRET: Google OAuth2 client secret used by current AppSettings. Default: empty. Values: secret string. Optional.
# GOOGLE_OAUTH2_CLIENT_SECRET=change-me

# GOOGLE_CLIENT_ID: Legacy Google OAuth client id alias retained for older env files. Default: none. Values: string. Optional; prefer GOOGLE_OAUTH2_CLIENT_ID.
# GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: Legacy Google OAuth client secret alias retained for older env files. Default: none. Values: secret string. Optional; prefer GOOGLE_OAUTH2_CLIENT_SECRET.
# GOOGLE_CLIENT_SECRET=change-me

# GOOGLE_REDIRECT_URI: Legacy Google OAuth redirect URI retained for older env files. Default: none. Values: URL. Optional; verify code support before use.
# GOOGLE_REDIRECT_URI=http://localhost:8191/auth/google/callback

# GITHUB_OAUTH2_CLIENT_ID: GitHub OAuth2 client id. Default: empty. Values: string. Optional.
# GITHUB_OAUTH2_CLIENT_ID=

# GITHUB_OAUTH2_CLIENT_SECRET: GitHub OAuth2 client secret. Default: empty. Values: secret string. Optional.
# GITHUB_OAUTH2_CLIENT_SECRET=change-me

# SIGNUP_TEST_MODE: Allow signup tests to re-register the same e-mail. Default: false. Values: bool. Optional/test only.
# SIGNUP_TEST_MODE=false

# ───────────────────────────────────────────────────────────────────────────────
# 7. EMAIL — console, SMTP/Mailpit and Resend delivery — Email backend and local Mailpit defaults.
# ───────────────────────────────────────────────────────────────────────────────

# EMAIL_BACKEND: Email backend. Default: console. Values: console | memory | smtp | resend. Optional.
# EMAIL_BACKEND=memory

# EMAIL_ENABLED: Legacy email send switch used by local env files. Default: none. Values: bool. Optional.
EMAIL_ENABLED=false

# EMAIL_FROM_ADDRESS: Default from e-mail address. Default: noreply@localhost. Values: e-mail. Optional.
EMAIL_FROM_ADDRESS=noreply@localhost

# EMAIL_FROM_NAME: Default from display name. Default: Litestar App. Values: string. Optional.
EMAIL_FROM_NAME=eWorkSuite

# EMAIL_SMTP_HOST: SMTP server host; local Mailpit uses localhost. Default: localhost. Values: host. Optional.
EMAIL_SMTP_HOST=localhost

# EMAIL_SMTP_PORT: SMTP server port; local Mailpit uses 1025. Default: 587. Values: port. Optional.
EMAIL_SMTP_PORT=1025

# EMAIL_SMTP_USER: SMTP username; blank for Mailpit. Default: empty. Values: string. Optional.
EMAIL_SMTP_USER=

# EMAIL_SMTP_PASSWORD: SMTP password or provider API key for resend fallback. Default: empty. Values: secret string. Optional.
EMAIL_SMTP_PASSWORD=change-me

# EMAIL_USE_TLS: Use STARTTLS for SMTP. Default: True. Values: bool. Optional.
EMAIL_USE_TLS=false

# EMAIL_USE_SSL: Use implicit SSL for SMTP. Default: False. Values: bool. Optional.
EMAIL_USE_SSL=false

# EMAIL_TIMEOUT: SMTP timeout in seconds. Default: 30. Values: integer seconds. Optional.
EMAIL_TIMEOUT=30

# RESEND_API_KEY: Resend API key when EMAIL_BACKEND=resend. Default: empty. Values: secret string. Required for resend.
# RESEND_API_KEY=change-me

# ───────────────────────────────────────────────────────────────────────────────
# 8. STORAGE AND BLOCKCHAIN — S3-compatible object storage and Kaspa integration — Storage provider selection plus optional RustFS/S3 and Kaspa network settings.
# ───────────────────────────────────────────────────────────────────────────────

# TEMPLATE_STORAGE_PROVIDER: Template storage provider. Default: fs. Values: fs | s3 | gcs | azure. Optional.
# TEMPLATE_STORAGE_PROVIDER=fs

# BLOB_STORAGE_PROVIDER: Blob storage provider. Default: s3. Values: fs | s3 | gcs | azure. Optional.
# BLOB_STORAGE_PROVIDER=s3

# AWS_ACCESS_KEY_ID: S3 access key id for RustFS/MinIO/S3. Default: provider default chain. Values: string. Optional.
# AWS_ACCESS_KEY_ID=app

# AWS_SECRET_ACCESS_KEY: S3 secret access key for RustFS/MinIO/S3. Default: provider default chain. Values: secret string. Optional.
# AWS_SECRET_ACCESS_KEY=change-me

# AWS_ENDPOINT_URL: S3-compatible endpoint; local RustFS API is localhost:19000. Default: provider default. Values: URL. Optional.
# AWS_ENDPOINT_URL=http://localhost:19000

# AWS_DEFAULT_REGION: S3 region for providers requiring one. Default: provider default. Values: region. Optional.
# AWS_DEFAULT_REGION=us-east-1

# STORAGE_BUCKET: Legacy upload bucket name for local examples. Default: none. Values: bucket name. Optional.
# STORAGE_BUCKET=uploads

# KASPA_DEBUG: Enable Kaspa integration debug logging. Default: False. Values: bool. Optional.
# KASPA_DEBUG=false

# KASPA_NETWORK: Kaspa network id. Default: required by KaspaSettings. Values: mainnet | testnet-10. Required if Kaspa code is used.
# KASPA_NETWORK=mainnet

# KASPA_RPC_URL: Kaspa RPC URL. Default: none. Values: URL. Optional.
# KASPA_RPC_URL=

# KASPA_RPC_USER: Kaspa RPC username. Default: none. Values: string. Optional.
# KASPA_RPC_USER=

# KASPA_RPC_PASSWORD: Kaspa RPC password. Default: none. Values: secret string. Optional.
# KASPA_RPC_PASSWORD=change-me

# KASPA_REST_URL: Kaspa REST API URL; default depends on network. Default: network public endpoint. Values: URL. Optional.
# KASPA_REST_URL=https://api.kaspa.org

# KASPA_REST_API_KEY: Kaspa REST API key. Default: none. Values: secret string. Optional.
# KASPA_REST_API_KEY=change-me

# KASPA_REST_API_KEY_HEADER_NAME: Kaspa REST API key header name. Default: api-key. Values: string. Optional.
# KASPA_REST_API_KEY_HEADER_NAME=api-key

# KASPA_FEE_ESTIMATOR_MAX_UTXOS: Maximum UTXOs fetched for fee estimation. Default: 1000. Values: integer. Optional.
# KASPA_FEE_ESTIMATOR_MAX_UTXOS=1000

# KASPA_FEE_ESTIMATOR_FALLBACK_FEERATE: Fallback Kaspa fee rate in sompi. Default: 316500. Values: integer. Optional.
# KASPA_FEE_ESTIMATOR_FALLBACK_FEERATE=316500

# ───────────────────────────────────────────────────────────────────────────────
# 9. OBSERVABILITY AND LOGGING — structured logs, OpenTelemetry and APM — Logging adapters, OTLP exporter endpoints, auth and sampling controls.
# ───────────────────────────────────────────────────────────────────────────────

# LOG_LEVEL: Python log level number. Default: 30. Values: 10 | 20 | 30 | 40 | 50. Optional.
LOG_LEVEL=20

# LOG_ADAPTERS: Enabled log adapters. Default: console,file,otlp-http. Values: comma list: console,file,otlp-http,otlp-grpc,elk. Optional.
LOG_ADAPTERS=console

# LOG_FILE_DIR: Log file directory; relative paths resolve under app home. Default: logs. Values: path. Optional.
# LOG_FILE_DIR=logs

# SAQ_LOG_LEVEL: SAQ logger level. Default: 50. Values: integer log level. Optional.
# SAQ_LOG_LEVEL=50

# SQLALCHEMY_LOG_LEVEL: SQLAlchemy logger level. Default: 30. Values: integer log level. Optional.
# SQLALCHEMY_LOG_LEVEL=30

# ASGI_ACCESS_LOG_LEVEL: ASGI access logger level. Default: 30. Values: integer log level. Optional.
# ASGI_ACCESS_LOG_LEVEL=30

# ASGI_ERROR_LOG_LEVEL: ASGI error logger level. Default: 30. Values: integer log level. Optional.
# ASGI_ERROR_LOG_LEVEL=30

# TRACING_ADAPTERS: Tracing exporters. Default: empty. Values: comma list: otlp-http,otlp-grpc,console,elk. Optional.
TRACING_ADAPTERS=

# TRACING_SERVICE_NAME: Tracing/APM service name. Default: taas. Values: string. Optional.
# TRACING_SERVICE_NAME=taas-server-py

# OTEL_SERVICE_NAME: OTEL service name override. Default: TAAS_SERVICE_NAME or ews. Values: string. Optional.
# OTEL_SERVICE_NAME=ews_api

# OTEL_EXPORTER_OTLP_ENDPOINT: General OTLP endpoint. Default: none. Values: URL. Optional.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# OTEL_LOGGING_OTLP_HTTP_ENDPOINT: OTLP HTTP logs endpoint. Default: http://localhost:4318/v1/logs. Values: URL. Optional.
# OTEL_LOGGING_OTLP_HTTP_ENDPOINT=http://localhost:4318/v1/logs

# OTEL_LOGGING_OTLP_GRPC_ENDPOINT: OTLP gRPC logs endpoint. Default: http://localhost:4317. Values: URL. Optional.
# OTEL_LOGGING_OTLP_GRPC_ENDPOINT=http://localhost:4317

# OTEL_TRACING_OTLP_HTTP_ENDPOINT: OTLP HTTP traces endpoint. Default: http://localhost:4318/v1/traces. Values: URL. Optional.
# OTEL_TRACING_OTLP_HTTP_ENDPOINT=http://localhost:4318/v1/traces

# OTEL_TRACING_OTLP_GRPC_ENDPOINT: OTLP gRPC traces endpoint. Default: http://localhost:4317. Values: URL. Optional.
# OTEL_TRACING_OTLP_GRPC_ENDPOINT=http://localhost:4317

# OTEL_EXPORTER_OTLP_INSECURE: Use insecure/no-TLS OTLP connection. Default: none. Values: bool. Optional.
# OTEL_EXPORTER_OTLP_INSECURE=true

# OTEL_AUTH_TYPE: OTLP auth type. Default: none. Values: basic | token | oidc. Optional.
# OTEL_AUTH_TYPE=

# OTEL_AUTH_USER: OTLP auth username. Default: none. Values: string. Optional.
# OTEL_AUTH_USER=change-me

# OTEL_AUTH_PASSWORD: OTLP auth password/token. Default: none. Values: secret string. Optional.
# OTEL_AUTH_PASSWORD=change-me

# OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED: Enable Python logging auto-instrumentation. Default: True. Values: bool. Optional.
# OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true

# OTEL_BSP_MAX_QUEUE_SIZE: Span processor queue capacity; exported by start script. Default: 2048. Values: integer. Optional.
# OTEL_BSP_MAX_QUEUE_SIZE=2048

# OTEL_BSP_MAX_EXPORT_BATCH_SIZE: Span processor max export batch size. Default: 512. Values: integer. Optional.
# OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512

# OTEL_BSP_SCHEDULE_DELAY: Span processor flush delay. Default: 5000. Values: integer ms. Optional.
# OTEL_BSP_SCHEDULE_DELAY=5000

# OTEL_BSP_EXPORT_TIMEOUT: Span export timeout. Default: 30000. Values: integer ms. Optional.
# OTEL_BSP_EXPORT_TIMEOUT=30000

# ELK_APM_ENABLED: Enable Elastic APM integration. Default: False. Values: bool. Optional.
# ELK_APM_ENABLED=false

# ELK_APM_HOST: Elastic APM server URL. Default: http://localhost:8200. Values: URL. Optional.
# ELK_APM_HOST=http://localhost:8200

# ELK_APM_SECRET: Elastic APM secret token. Default: none. Values: secret string. Optional.
# ELK_APM_SECRET=change-me

# SAMPLING_RATE: Tracing sampling rate. Default: 0.1. Values: float 0..1. Optional.
# SAMPLING_RATE=0.1

# HOST_NAME: Host name resource attribute. Default: none. Values: string. Optional.
# HOST_NAME=

# ───────────────────────────────────────────────────────────────────────────────
# 10. TESTING — test-only database, Redis and deterministic signup controls — Variables normally used only by pytest/unit_dev/e2e commands.
# ───────────────────────────────────────────────────────────────────────────────

# RESILIANT_TEST_DATABASE_URL: Override DATABASE_URL for resiliant unit tests. Default: unset. Values: SQLAlchemy URL. Optional/test only.
# RESILIANT_TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/taas_next_test

# IDEMPOTENCY_TEST_REDIS_URL: Redis URL for idempotency unit tests. Default: redis://localhost:16380/15. Values: redis URL. Optional/test only.
# IDEMPOTENCY_TEST_REDIS_URL=redis://localhost:16380/15
