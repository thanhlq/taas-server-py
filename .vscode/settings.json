{
  "[markdown]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[python]": {
    "editor.formatOnSave": false,
    "editor.formatOnSaveMode": "file",
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.trimAutoWhitespace": true,
    // see https://marketplace.visualstudio.com/items?itemName=charliermarsh.ruff
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      // "source.fixAll": explicit | never |
      //  fix lint violations on-save by enabling the source.fixAll: explicit
      "source.fixAll": "explicit",
      "source.organizeImports": "never"
    }
  },
  "files.associations": {
      "*.json": "jsonc"
      // Or for a specific file:
      // "myconfig.json": "jsonc"
  },
  "ruff.configuration": "./ruff.toml",
  "python.languageServer": "Pylance",
  "python.terminal.activateEnvironment": false,
  "python.terminal.activateEnvInCurrentTerminal": false,
  "python-envs.terminal.autoActivationType": "off",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // "python.analysis.autoSearchPaths": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.includeInSetting": [
    "**/*.py"
  ],
  "python.analysis.importFormat": "absolute",
  "python.analysis.packageIndexDepths": [
    {
      "name": "foundation",
      "depth": 3
    },
    {
      "name": "db",
      "depth": 3
    },
    {
      "name": "slowapi_advanced",
      "depth": 3
    },
    {
      "name": "store_memcached",
      "depth": 3
    },
    {
      "name": "store_redis",
      "depth": 3
    },
    {
      "name": "http_fastapi",
      "depth": 3
    },
    {
      "name": "http_litestar",
      "depth": 3
    },
    {
      "name": "banking_core",
      "depth": 3
    },
    {
      "name": "iam",
      "depth": 3
    },
    {
      "name": "iam_keycloak",
      "depth": 3
    },
    {
      "name": "ews",
      "depth": 3
    },
    {
      "name": "resiliant",
      "depth": 3
    },
    {
      "name": "block-kaspa",
      "depth": 3
    },
    {
      "name": "ews_api",
      "depth": 3
    },
    {
      "name": "ews_worker",
      "depth": 3
    },
    {
      "name": "ews_api_litestar",
      "depth": 3
    },
    {
      "name": "messaging_kafka",
      "depth": 3
    },
    {
      "name": "messaging_faststream",
      "depth": 3
    },
    {
      "name": "outbox_worker",
      "depth": 3
    }
  ],
  "search.exclude": {
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/.turbo": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/*.log": true,
    "**/pnpm-lock.yaml": true,
    // "**/*.json": true,
  },
  // "files.exclude": {
  //   "**/node_modules": true,
  //   "**/dist": true,
  //   "**/*.lock": true,
  //   "**/*.log": true
  // },
  "makefile.configureOnOpen": false
}
