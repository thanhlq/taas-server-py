# syntax=docker/dockerfile:1.7
# File: Dockerfile.prod
# ─────────────────────────────────────────────────────────────────────────────
# Single production image for every taas-server-py service. The service to run
# is selected at RUNTIME via the APP_MODULE env var (python -m $APP_MODULE):
#   - apps/ews_api            (FastAPI HTTP API)      APP_MODULE=ews_api
#   - apps/ews_api_litestar   (Litestar HTTP API)     APP_MODULE=ews_api_litestar
#   - apps/ews_worker         (SAQ/Kafka worker)      APP_MODULE=ews_worker
#   - apps/outbox_worker      (transactional outbox)  APP_MODULE=outbox_worker
#   - db migrations                                   python -m db.migrations upgrade
#
# The whole workspace is installed (non-editable) because the shared `foundation`
# library imports both HTTP frameworks at module load, so a per-service split
# cannot drop either framework without application changes. Dev dependencies are
# excluded (--no-dev) to keep the runtime image lean.
#
# Example:
#   docker build -f Dockerfile.prod -t taas-ews-py:prod .
#   docker run -e APP_MODULE=ews_api_litestar taas-ews-py:prod
#
# For local development / debugging use Dockerfile.dev instead.
#
# Best practices applied: multi-stage build, non-root user, tini as PID 1,
# bytecode pre-compiled, only the runtime venv copied into the final stage.
# The healthcheck is intentionally left to docker-compose so the same image
# serves both HTTP services (health endpoint) and headless workers.
# ─────────────────────────────────────────────────────────────────────────────

ARG REGISTRY="docker.io"
ARG PYTHON_BASE_IMAGE_VERSION=3.14.5-slim-bookworm

#############################################################################
# Stage 1: builder — resolve & install the selected package into a venv
#############################################################################
FROM ${REGISTRY}/python:${PYTHON_BASE_IMAGE_VERSION} AS builder
ENV DEBIAN_FRONTEND=noninteractive

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=false \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Pinned uv binary from the official distroless image.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Build toolchain in case a dependency needs to compile from source.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/log/* /tmp/*

WORKDIR /app

# 1) Install ONLY the third-party dependency closure of the whole workspace.
#    Bind-mounting the lockfile + every workspace member's pyproject.toml lets
#    uv resolve the workspace without copying source, so this layer is cached
#    until the lockfile or a pyproject.toml changes.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=libs/foundation/pyproject.toml,target=libs/foundation/pyproject.toml \
    --mount=type=bind,source=libs/http_fastapi/pyproject.toml,target=libs/http_fastapi/pyproject.toml \
    --mount=type=bind,source=libs/http_litestar/pyproject.toml,target=libs/http_litestar/pyproject.toml \
    --mount=type=bind,source=libs/db/pyproject.toml,target=libs/db/pyproject.toml \
    --mount=type=bind,source=libs/ews/pyproject.toml,target=libs/ews/pyproject.toml \
    --mount=type=bind,source=libs/iam/pyproject.toml,target=libs/iam/pyproject.toml \
    --mount=type=bind,source=libs/store_redis/pyproject.toml,target=libs/store_redis/pyproject.toml \
    --mount=type=bind,source=libs/store_memcached/pyproject.toml,target=libs/store_memcached/pyproject.toml \
    --mount=type=bind,source=libs/slowapi_advanced/pyproject.toml,target=libs/slowapi_advanced/pyproject.toml \
    --mount=type=bind,source=apps/ews_api/pyproject.toml,target=apps/ews_api/pyproject.toml \
    --mount=type=bind,source=apps/ews_api_litestar/pyproject.toml,target=apps/ews_api_litestar/pyproject.toml \
    --mount=type=bind,source=apps/ews_worker/pyproject.toml,target=apps/ews_worker/pyproject.toml \
    --mount=type=bind,source=apps/outbox_worker/pyproject.toml,target=apps/outbox_worker/pyproject.toml \
    uv sync --frozen --no-dev --no-install-workspace --all-packages

# 2) Copy the source and install ALL workspace packages as non-editable wheels.
#    `foundation` imports both HTTP frameworks at module load, so every service
#    (including headless workers and the migrator) needs the full set installed.
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --all-packages

#############################################################################
# Stage 2: runtime — minimal image carrying only the venv and a non-root user
#############################################################################
FROM ${REGISTRY}/python:${PYTHON_BASE_IMAGE_VERSION} AS runtime
ENV DEBIAN_FRONTEND=noninteractive

# Which python -m module this image runs by default. Overridable per service via
# the compose `environment:` block so one image serves every service.
ENV APP_MODULE=ews_api

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    PYTHONHASHSEED=random \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# tini for correct PID-1 signal handling / zombie reaping. No build tools,
# no curl, no node — health checks use the bundled Python interpreter.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tini ca-certificates \
    && rm -rf /var/lib/apt/lists/* /var/log/* /tmp/*

# Dedicated unprivileged user.
RUN groupadd --system --gid 1000 app \
    && useradd --system --uid 1000 --gid 1000 --no-create-home app

WORKDIR /app

# Copy the fully built virtual environment (interpreter-compatible with the
# identical base image) owned by the non-root user.
COPY --from=builder --chown=app:app /app/.venv /app/.venv

USER app

STOPSIGNAL SIGTERM

# `exec` so tini/python receives SIGTERM directly (clean shutdown). ${APP_MODULE}
# is expanded by the shell at container start and can be overridden per service.
ENTRYPOINT ["tini", "--"]
CMD ["sh", "-c", "exec python -m ${APP_MODULE}"]
