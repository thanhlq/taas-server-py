{
  "catalog": "ews",
  "version": 1,
  "description": "Business roles and permissions of the EWS apps (PPM, CRM, Site Builder, Media Library), taas-specs/iam/specs/app-roles-spec.md. Synced into taas_casbin_rule (p rows) at EWS API start-up. Roles with 'extends' are defined by the IAM catalog (iam-rbac.json); this file only adds their business permissions. Permission = '<resource>:<action>', '*' = any.",
  "namespaces": ["ppm", "crm", "sites", "media"],
  "resources": [
    { "key": "ppm.project", "name": "Projects", "actions": ["create", "read", "update", "delete"] },
    { "key": "ppm.project_member", "name": "Project members", "actions": ["create", "read", "update", "delete"] },
    { "key": "ppm.workflow", "name": "Project workflows and stages", "actions": ["create", "read", "update", "delete"] },
    { "key": "ppm.task", "name": "Tasks, task lists, iterations", "actions": ["create", "read", "update", "delete"] },
    { "key": "ppm.task_activity", "name": "Comments and time logs", "actions": ["create", "read", "update", "delete"] },
    { "key": "crm.account", "name": "CRM accounts", "actions": ["create", "read", "update", "delete", "export"] },
    { "key": "sites.site", "name": "Sites", "actions": ["create", "read", "update", "delete"] },
    { "key": "sites.theme", "name": "Site theme, header and footer", "actions": ["update"] },
    { "key": "sites.domain", "name": "Site domains", "actions": ["read", "manage"] },
    { "key": "sites.page", "name": "Pages, drafts and releases", "actions": ["create", "read", "update", "delete", "publish"] },
    { "key": "sites.menu", "name": "Site menus", "actions": ["update"] },
    { "key": "sites.redirect", "name": "Site redirects", "actions": ["manage"] },
    { "key": "sites.seo", "name": "SEO settings", "actions": ["update"] },
    { "key": "sites.member", "name": "Site members (roles on the site)", "actions": ["read", "manage"] },
    { "key": "sites.submission", "name": "Form submissions", "actions": ["read", "export", "delete"] },
    { "key": "sites.ai", "name": "AI content assist", "actions": ["use"] },
    { "key": "media.asset", "name": "Media files", "actions": ["create", "read", "update", "delete"] },
    { "key": "media.folder", "name": "Media folders", "actions": ["create", "read", "update", "delete"] }
  ],
  "roles": [
    {
      "key": "project_admin",
      "name": "Project Admin",
      "scope": "project",
      "description": "Full permission on the assigned project.",
      "permissions": [
        "ppm.project:read",
        "ppm.project:update",
        "ppm.project:delete",
        "ppm.project_member:*",
        "ppm.workflow:*",
        "ppm.task:*",
        "ppm.task_activity:*"
      ]
    },
    {
      "key": "project_member",
      "name": "Project Member",
      "scope": "project",
      "description": "Works on the tasks of the assigned project.",
      "permissions": [
        "ppm.project:read",
        "ppm.project_member:read",
        "ppm.workflow:read",
        "ppm.task:create",
        "ppm.task:read",
        "ppm.task:update",
        "ppm.task_activity:create",
        "ppm.task_activity:read",
        "ppm.task_activity:update"
      ]
    },
    {
      "key": "project_viewer",
      "name": "Project Viewer",
      "scope": "project",
      "description": "Read-only access to the assigned project (clients, stakeholders).",
      "permissions": [
        "ppm.project:read",
        "ppm.project_member:read",
        "ppm.workflow:read",
        "ppm.task:read",
        "ppm.task_activity:read"
      ]
    },
    {
      "key": "site_admin",
      "name": "Site Admin",
      "scope": "site",
      "description": "Everything on the assigned site: settings, theme, domains, members, pages, publishing.",
      "permissions": [
        "sites.site:read",
        "sites.site:update",
        "sites.site:delete",
        "sites.theme:*",
        "sites.domain:*",
        "sites.page:*",
        "sites.menu:*",
        "sites.redirect:*",
        "sites.seo:*",
        "sites.member:*",
        "sites.submission:*",
        "sites.ai:*"
      ]
    },
    {
      "key": "site_editor",
      "name": "Site Editor",
      "scope": "site",
      "description": "Edits and publishes pages, menus, redirects and SEO; reads form submissions.",
      "permissions": [
        "sites.site:read",
        "sites.page:*",
        "sites.menu:update",
        "sites.redirect:manage",
        "sites.seo:update",
        "sites.member:read",
        "sites.submission:read",
        "sites.submission:export",
        "sites.ai:use"
      ]
    },
    {
      "key": "site_author",
      "name": "Site Author",
      "scope": "site",
      "description": "Creates and edits drafts; cannot publish or change the theme and domains.",
      "permissions": [
        "sites.site:read",
        "sites.page:create",
        "sites.page:read",
        "sites.page:update",
        "sites.menu:update",
        "sites.member:read",
        "sites.ai:use"
      ]
    },
    {
      "key": "site_viewer",
      "name": "Site Viewer",
      "scope": "site",
      "description": "Reads drafts and previews of the assigned site (reviewers, clients).",
      "permissions": ["sites.site:read", "sites.page:read", "sites.member:read"]
    },
    {
      "key": "org_admin",
      "extends": "iam",
      "scope": "org",
      "description": "Organization Admin: full permission on the projects, CRM data, sites and media library of the organization (Iam-0510).",
      "permissions": [
        "ppm.project:*",
        "ppm.project_member:*",
        "ppm.workflow:*",
        "ppm.task:*",
        "ppm.task_activity:*",
        "crm.account:*",
        "sites.site:*",
        "sites.theme:*",
        "sites.domain:*",
        "sites.page:*",
        "sites.menu:*",
        "sites.redirect:*",
        "sites.seo:*",
        "sites.member:*",
        "sites.submission:*",
        "sites.ai:*",
        "media.asset:*",
        "media.folder:*"
      ]
    },
    {
      "key": "org_member",
      "extends": "iam",
      "scope": "org",
      "description": "Organization Member: creates projects (and becomes their Project Admin), works with CRM accounts, browses and uploads media.",
      "permissions": [
        "ppm.project:create",
        "crm.account:create",
        "crm.account:read",
        "crm.account:update",
        "media.asset:create",
        "media.asset:read",
        "media.asset:update",
        "media.folder:create",
        "media.folder:read"
      ]
    }
  ]
}
