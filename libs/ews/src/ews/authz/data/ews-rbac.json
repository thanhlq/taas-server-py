{
  "catalog": "ews",
  "version": 1,
  "description": "Business roles and permissions of the EWS apps (PPM, CRM, Site Builder, Media Library, File Manager, Knowledge Center, Blog), taas-specs/iam/specs/app-roles-spec.md. Synced into taas_casbin_rule (p rows) at EWS API start-up. Roles with 'extends' are defined by the IAM catalog (iam-rbac.json); this file only adds their business permissions. Permission = '<resource>:<action>', '*' = any.",
  "namespaces": ["ppm", "crm", "sites", "media", "files", "kb", "blog"],
  "resources": [
    { "key": "ppm.project", "name": "Projects", "actions": ["create", "read", "update", "delete"] },
    { "key": "ppm.project_member", "name": "Project members", "actions": ["create", "read", "update", "delete"] },
    { "key": "ppm.workflow", "name": "Project workflows and stages", "actions": ["create", "read", "update", "delete"] },
    { "key": "ppm.task", "name": "Tasks, task lists, iterations", "actions": ["create", "read", "update", "delete"] },
    { "key": "ppm.task_activity", "name": "Comments and time logs", "actions": ["create", "read", "update", "delete"] },
    { "key": "crm.account", "name": "CRM accounts", "actions": ["create", "read", "update", "delete", "export"] },
    { "key": "sites.site", "name": "Sites", "actions": ["create", "read", "update", "delete"] },
    { "key": "sites.theme", "name": "Site theme, header and footer", "actions": ["update"] },
    { "key": "sites.domain", "name": "Site domains", "actions": ["read", "manage"] },
    { "key": "sites.page", "name": "Pages, drafts and releases", "actions": ["create", "read", "update", "delete", "publish"] },
    { "key": "sites.menu", "name": "Site menus", "actions": ["update"] },
    { "key": "sites.redirect", "name": "Site redirects", "actions": ["manage"] },
    { "key": "sites.seo", "name": "SEO settings", "actions": ["update"] },
    { "key": "sites.member", "name": "Site members (roles on the site)", "actions": ["read", "manage"] },
    { "key": "sites.submission", "name": "Form submissions", "actions": ["read", "export", "delete"] },
    { "key": "sites.ai", "name": "AI content assist", "actions": ["use"] },
    { "key": "media.asset", "name": "Media files", "actions": ["create", "read", "update", "delete"] },
    { "key": "media.folder", "name": "Media folders", "actions": ["create", "read", "update", "delete"] },
    { "key": "files.drive", "name": "Drives (organization, shared, personal) and their settings", "actions": ["create", "read", "update", "delete"] },
    { "key": "files.item", "name": "Folders, files and versions of a drive", "actions": ["create", "read", "update", "delete", "restore", "comment", "share"] },
    { "key": "files.member", "name": "Drive members (roles on the drive)", "actions": ["read", "manage"] },
    { "key": "kb.space", "name": "Knowledge spaces and their settings", "actions": ["create", "read", "update", "delete"] },
    { "key": "kb.space_member", "name": "Space members (roles on the space)", "actions": ["read", "manage"] },
    { "key": "kb.page", "name": "Pages, drafts, revisions and attachments", "actions": ["create", "read", "update", "delete", "publish", "verify"] },
    { "key": "kb.link", "name": "Share links of pages", "actions": ["create", "read", "revoke"] },
    { "key": "kb.ai", "name": "Ask and writing help", "actions": ["use"] },
    { "key": "blog.blog", "name": "Blogs and their settings", "actions": ["create", "read", "update", "delete"] },
    { "key": "blog.member", "name": "Blog members (roles on the blog)", "actions": ["read", "manage"] },
    { "key": "blog.post", "name": "Posts, drafts and revisions ('update_own' = posts the user authors)", "actions": ["create", "read", "update", "update_own", "delete", "submit", "review", "publish"] },
    { "key": "blog.taxonomy", "name": "Categories, tags and author profiles", "actions": ["read", "manage"] },
    { "key": "blog.ai", "name": "AI writing assistant", "actions": ["use"] }
  ],
  "roles": [
    {
      "key": "project_admin",
      "name": "Project Admin",
      "scope": "project",
      "description": "Full permission on the assigned project.",
      "permissions": [
        "ppm.project:read",
        "ppm.project:update",
        "ppm.project:delete",
        "ppm.project_member:*",
        "ppm.workflow:*",
        "ppm.task:*",
        "ppm.task_activity:*"
      ]
    },
    {
      "key": "project_member",
      "name": "Project Member",
      "scope": "project",
      "description": "Works on the tasks of the assigned project.",
      "permissions": [
        "ppm.project:read",
        "ppm.project_member:read",
        "ppm.workflow:read",
        "ppm.task:create",
        "ppm.task:read",
        "ppm.task:update",
        "ppm.task_activity:create",
        "ppm.task_activity:read",
        "ppm.task_activity:update"
      ]
    },
    {
      "key": "project_viewer",
      "name": "Project Viewer",
      "scope": "project",
      "description": "Read-only access to the assigned project (clients, stakeholders).",
      "permissions": [
        "ppm.project:read",
        "ppm.project_member:read",
        "ppm.workflow:read",
        "ppm.task:read",
        "ppm.task_activity:read"
      ]
    },
    {
      "key": "site_admin",
      "name": "Site Admin",
      "scope": "site",
      "description": "Everything on the assigned site: settings, theme, domains, members, pages, publishing.",
      "permissions": [
        "sites.site:read",
        "sites.site:update",
        "sites.site:delete",
        "sites.theme:*",
        "sites.domain:*",
        "sites.page:*",
        "sites.menu:*",
        "sites.redirect:*",
        "sites.seo:*",
        "sites.member:*",
        "sites.submission:*",
        "sites.ai:*"
      ]
    },
    {
      "key": "site_editor",
      "name": "Site Editor",
      "scope": "site",
      "description": "Edits and publishes pages, menus, redirects and SEO; reads form submissions.",
      "permissions": [
        "sites.site:read",
        "sites.page:*",
        "sites.menu:update",
        "sites.redirect:manage",
        "sites.seo:update",
        "sites.member:read",
        "sites.submission:read",
        "sites.submission:export",
        "sites.ai:use"
      ]
    },
    {
      "key": "site_author",
      "name": "Site Author",
      "scope": "site",
      "description": "Creates and edits drafts; cannot publish or change the theme and domains.",
      "permissions": [
        "sites.site:read",
        "sites.page:create",
        "sites.page:read",
        "sites.page:update",
        "sites.menu:update",
        "sites.member:read",
        "sites.ai:use"
      ]
    },
    {
      "key": "site_viewer",
      "name": "Site Viewer",
      "scope": "site",
      "description": "Reads drafts and previews of the assigned site (reviewers, clients).",
      "permissions": ["sites.site:read", "sites.page:read", "sites.member:read"]
    },
    {
      "key": "drive_manager",
      "name": "Drive Manager",
      "scope": "drive",
      "description": "Everything on the drive: files, sharing, members, settings (File-0200).",
      "permissions": ["files.drive:read", "files.drive:update", "files.drive:delete", "files.item:*", "files.member:*"]
    },
    {
      "key": "drive_editor",
      "name": "Drive Editor",
      "scope": "drive",
      "description": "Uploads, new versions, rename, move inside the drive, delete to and restore from the trash (File-0306).",
      "permissions": [
        "files.drive:read",
        "files.item:create",
        "files.item:read",
        "files.item:update",
        "files.item:delete",
        "files.item:restore",
        "files.item:comment",
        "files.member:read"
      ]
    },
    {
      "key": "drive_commenter",
      "name": "Drive Commenter",
      "scope": "drive",
      "description": "Sees, previews and downloads; comments and requests approvals.",
      "permissions": ["files.drive:read", "files.item:read", "files.item:comment", "files.member:read"]
    },
    {
      "key": "drive_viewer",
      "name": "Drive Viewer",
      "scope": "drive",
      "description": "Sees, previews and downloads.",
      "permissions": ["files.drive:read", "files.item:read", "files.member:read"]
    },
    {
      "key": "kb_space_admin",
      "name": "Space Admin",
      "scope": "kb-space",
      "description": "Settings, members and every page of the space (Kb-0100).",
      "permissions": ["kb.space:read", "kb.space:update", "kb.space:delete", "kb.space_member:*", "kb.page:*", "kb.link:*", "kb.ai:*"]
    },
    {
      "key": "kb_space_editor",
      "name": "Space Editor",
      "scope": "kb-space",
      "description": "Creates, edits, publishes and verifies pages; creates share links.",
      "permissions": ["kb.space:read", "kb.space_member:read", "kb.page:*", "kb.link:*", "kb.ai:use"]
    },
    {
      "key": "kb_space_viewer",
      "name": "Space Viewer",
      "scope": "kb-space",
      "description": "Reads published pages (granted implicitly by the space visibility).",
      "permissions": ["kb.space:read", "kb.space_member:read", "kb.page:read", "kb.ai:use"]
    },
    {
      "key": "kb_admin",
      "name": "Knowledge Admin",
      "scope": "tenant",
      "description": "Creates and manages every space of the tenant (Kb-0101).",
      "permissions": ["kb.space:*", "kb.space_member:*", "kb.page:*", "kb.link:*", "kb.ai:*"]
    },
    {
      "key": "blog_admin",
      "name": "Blog Admin",
      "scope": "blog",
      "description": "Settings, address, members, taxonomy and every post of the blog.",
      "permissions": ["blog.blog:read", "blog.blog:update", "blog.blog:delete", "blog.member:*", "blog.post:*", "blog.taxonomy:*", "blog.ai:*"]
    },
    {
      "key": "blog_editor",
      "name": "Blog Editor",
      "scope": "blog",
      "description": "Edits every post, reviews, schedules, publishes; manages categories, tags and authors.",
      "permissions": ["blog.blog:read", "blog.member:read", "blog.post:*", "blog.taxonomy:*", "blog.ai:use"]
    },
    {
      "key": "blog_author",
      "name": "Blog Author",
      "scope": "blog",
      "description": "Creates posts, edits its own posts and submits them for review (no publish).",
      "permissions": [
        "blog.blog:read",
        "blog.member:read",
        "blog.post:create",
        "blog.post:read",
        "blog.post:update_own",
        "blog.post:submit",
        "blog.taxonomy:read",
        "blog.ai:use"
      ]
    },
    {
      "key": "blog_viewer",
      "name": "Blog Viewer",
      "scope": "blog",
      "description": "Reads drafts and previews (reviewers, legal).",
      "permissions": ["blog.blog:read", "blog.member:read", "blog.post:read", "blog.taxonomy:read"]
    },
    {
      "key": "org_admin",
      "extends": "iam",
      "scope": "org",
      "description": "Organization Admin: full permission on the projects, CRM data, sites, media library, drives, knowledge spaces and blogs of the organization (Iam-0510).",
      "permissions": [
        "ppm.project:*",
        "ppm.project_member:*",
        "ppm.workflow:*",
        "ppm.task:*",
        "ppm.task_activity:*",
        "crm.account:*",
        "sites.site:*",
        "sites.theme:*",
        "sites.domain:*",
        "sites.page:*",
        "sites.menu:*",
        "sites.redirect:*",
        "sites.seo:*",
        "sites.member:*",
        "sites.submission:*",
        "sites.ai:*",
        "media.asset:*",
        "media.folder:*",
        "files.drive:*",
        "files.item:*",
        "files.member:*",
        "kb.space:*",
        "kb.space_member:*",
        "kb.page:*",
        "kb.link:*",
        "kb.ai:*",
        "blog.blog:*",
        "blog.member:*",
        "blog.post:*",
        "blog.taxonomy:*",
        "blog.ai:*"
      ]
    },
    {
      "key": "org_member",
      "extends": "iam",
      "scope": "org",
      "description": "Organization Member: creates projects (and becomes their Project Admin), works with CRM accounts, browses and uploads media.",
      "permissions": [
        "ppm.project:create",
        "crm.account:create",
        "crm.account:read",
        "crm.account:update",
        "media.asset:create",
        "media.asset:read",
        "media.asset:update",
        "media.folder:create",
        "media.folder:read"
      ]
    }
  ]
}
