{
  "description": "Shared decision vectors of the domain RBAC (taas-specs/iam/specs/authorization-rbac-spec.md). Owner: taas-server-js @taas/iam; copied to taas-server-py ews.authz by taas-tools/rbac-catalogs/sync_rbac_catalogs.py. Both runtimes evaluate every case with the policies of iam-rbac.json + ews-rbac.json and must return 'allowed'. grants = [role, domain] of the user; domains = the object's domains, most specific first. T tenant, R root organization, C child organization, P project, S site, D drive, K knowledge space, B blog, X team.",
  "cases": [
    { "name": "tenant admin may do anything in its tenant (IAM)", "grants": [["tenant_admin", "tenant:T"]], "domains": ["org:R", "tenant:T"], "resource": "iam.organization", "action": "delete", "allowed": true },
    { "name": "tenant admin may do anything in its tenant (business)", "grants": [["tenant_admin", "tenant:T"]], "domains": ["project:P", "org:C", "org:R", "tenant:T"], "resource": "ppm.project", "action": "delete", "allowed": true },
    { "name": "tenant admin oversees every drive", "grants": [["tenant_admin", "tenant:T"]], "domains": ["drive:D", "tenant:T"], "resource": "files.item", "action": "restore", "allowed": true },
    { "name": "a role of another tenant does not apply", "grants": [["tenant_admin", "tenant:T2"]], "domains": ["org:R", "tenant:T"], "resource": "iam.member", "action": "read", "allowed": false },
    { "name": "no grant, no access", "grants": [], "domains": ["org:R", "tenant:T"], "resource": "ppm.project", "action": "read", "allowed": false },
    { "name": "org admin cannot delete its organization (Iam-0510)", "grants": [["org_admin", "org:R"]], "domains": ["org:R", "tenant:T"], "resource": "iam.organization", "action": "delete", "allowed": false },
    { "name": "org admin manages members", "grants": [["org_admin", "org:R"]], "domains": ["org:R", "tenant:T"], "resource": "iam.member", "action": "update", "allowed": true },
    { "name": "org admin rights flow down to sub-organizations", "grants": [["org_admin", "org:R"]], "domains": ["project:P", "org:C", "org:R", "tenant:T"], "resource": "ppm.task", "action": "delete", "allowed": true },
    { "name": "org admin rights do not flow up", "grants": [["org_admin", "org:C"]], "domains": ["project:P", "org:R", "tenant:T"], "resource": "ppm.task", "action": "read", "allowed": false },
    { "name": "org admin owns the drives of its organization", "grants": [["org_admin", "org:R"]], "domains": ["drive:D", "org:R", "tenant:T"], "resource": "files.member", "action": "manage", "allowed": true },
    { "name": "org admin creates knowledge spaces (Kb-0101)", "grants": [["org_admin", "org:R"]], "domains": ["org:R", "tenant:T"], "resource": "kb.space", "action": "create", "allowed": true },
    { "name": "org admin publishes blog posts", "grants": [["org_admin", "org:R"]], "domains": ["blog:B", "org:R", "tenant:T"], "resource": "blog.post", "action": "publish", "allowed": true },
    { "name": "org member reads its organization", "grants": [["org_member", "org:R"]], "domains": ["org:R", "tenant:T"], "resource": "iam.organization", "action": "read", "allowed": true },
    { "name": "org member does not invite", "grants": [["org_member", "org:R"]], "domains": ["org:R", "tenant:T"], "resource": "iam.invitation", "action": "create", "allowed": false },
    { "name": "org member creates projects", "grants": [["org_member", "org:R"]], "domains": ["org:R", "tenant:T"], "resource": "ppm.project", "action": "create", "allowed": true },
    { "name": "org member does not delete CRM accounts", "grants": [["org_member", "org:R"]], "domains": ["org:R", "tenant:T"], "resource": "crm.account", "action": "delete", "allowed": false },
    { "name": "org member has no catalog right on shared drives", "grants": [["org_member", "org:R"]], "domains": ["drive:D", "org:R", "tenant:T"], "resource": "files.item", "action": "read", "allowed": false },
    { "name": "org member does not create knowledge spaces", "grants": [["org_member", "org:R"]], "domains": ["org:R", "tenant:T"], "resource": "kb.space", "action": "create", "allowed": false },
    { "name": "project admin deletes tasks of its project", "grants": [["project_admin", "project:P"]], "domains": ["project:P", "org:R", "tenant:T"], "resource": "ppm.task", "action": "delete", "allowed": true },
    { "name": "a project role does not leak to another project", "grants": [["project_admin", "project:P"]], "domains": ["project:Q", "org:R", "tenant:T"], "resource": "ppm.task", "action": "read", "allowed": false },
    { "name": "project viewer only reads", "grants": [["project_viewer", "project:P"]], "domains": ["project:P", "org:R", "tenant:T"], "resource": "ppm.task", "action": "update", "allowed": false },
    { "name": "site author edits pages", "grants": [["site_author", "site:S"]], "domains": ["site:S", "org:R", "tenant:T"], "resource": "sites.page", "action": "update", "allowed": true },
    { "name": "site author does not publish", "grants": [["site_author", "site:S"]], "domains": ["site:S", "org:R", "tenant:T"], "resource": "sites.page", "action": "publish", "allowed": false },
    { "name": "drive manager manages members", "grants": [["drive_manager", "drive:D"]], "domains": ["drive:D", "org:R", "tenant:T"], "resource": "files.member", "action": "manage", "allowed": true },
    { "name": "drive editor deletes to the trash", "grants": [["drive_editor", "drive:D"]], "domains": ["drive:D", "org:R", "tenant:T"], "resource": "files.item", "action": "delete", "allowed": true },
    { "name": "drive editor restores from the trash (File-0306)", "grants": [["drive_editor", "drive:D"]], "domains": ["drive:D", "org:R", "tenant:T"], "resource": "files.item", "action": "restore", "allowed": true },
    { "name": "drive editor does not manage members", "grants": [["drive_editor", "drive:D"]], "domains": ["drive:D", "org:R", "tenant:T"], "resource": "files.member", "action": "manage", "allowed": false },
    { "name": "drive commenter comments", "grants": [["drive_commenter", "drive:D"]], "domains": ["drive:D", "org:R", "tenant:T"], "resource": "files.item", "action": "comment", "allowed": true },
    { "name": "drive viewer does not upload", "grants": [["drive_viewer", "drive:D"]], "domains": ["drive:D", "org:R", "tenant:T"], "resource": "files.item", "action": "create", "allowed": false },
    { "name": "a drive role does not leak to another drive", "grants": [["drive_manager", "drive:D"]], "domains": ["drive:E", "org:R", "tenant:T"], "resource": "files.item", "action": "read", "allowed": false },
    { "name": "space viewer reads pages", "grants": [["kb_space_viewer", "kb-space:K"]], "domains": ["kb-space:K", "org:R", "tenant:T"], "resource": "kb.page", "action": "read", "allowed": true },
    { "name": "space viewer does not edit", "grants": [["kb_space_viewer", "kb-space:K"]], "domains": ["kb-space:K", "org:R", "tenant:T"], "resource": "kb.page", "action": "update", "allowed": false },
    { "name": "space editor publishes", "grants": [["kb_space_editor", "kb-space:K"]], "domains": ["kb-space:K", "org:R", "tenant:T"], "resource": "kb.page", "action": "publish", "allowed": true },
    { "name": "space editor does not delete the space", "grants": [["kb_space_editor", "kb-space:K"]], "domains": ["kb-space:K", "org:R", "tenant:T"], "resource": "kb.space", "action": "delete", "allowed": false },
    { "name": "knowledge admin creates spaces in its tenant", "grants": [["kb_admin", "tenant:T"]], "domains": ["org:C", "org:R", "tenant:T"], "resource": "kb.space", "action": "create", "allowed": true },
    { "name": "blog author edits its own posts", "grants": [["blog_author", "blog:B"]], "domains": ["blog:B", "org:R", "tenant:T"], "resource": "blog.post", "action": "update_own", "allowed": true },
    { "name": "blog author does not edit other posts", "grants": [["blog_author", "blog:B"]], "domains": ["blog:B", "org:R", "tenant:T"], "resource": "blog.post", "action": "update", "allowed": false },
    { "name": "blog author does not publish", "grants": [["blog_author", "blog:B"]], "domains": ["blog:B", "org:R", "tenant:T"], "resource": "blog.post", "action": "publish", "allowed": false },
    { "name": "blog editor publishes", "grants": [["blog_editor", "blog:B"]], "domains": ["blog:B", "org:R", "tenant:T"], "resource": "blog.post", "action": "publish", "allowed": true },
    { "name": "blog editor does not delete the blog", "grants": [["blog_editor", "blog:B"]], "domains": ["blog:B", "org:R", "tenant:T"], "resource": "blog.blog", "action": "delete", "allowed": false },
    { "name": "team admin manages its team", "grants": [["team_admin", "team:X"]], "domains": ["team:X", "org:R", "tenant:T"], "resource": "iam.team", "action": "delete", "allowed": true },
    { "name": "a role on a narrower domain kind does not apply to the organization", "grants": [["drive_manager", "drive:D"]], "domains": ["org:R", "tenant:T"], "resource": "files.drive", "action": "create", "allowed": false }
  ]
}
